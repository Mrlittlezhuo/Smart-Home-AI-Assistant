# 普通配置
DATABASE_URL=postgresql+asyncpg://whole_home:whole_home@localhost:5433/whole_home
CHECKPOINT_PG_DSN=postgresql://whole_home:whole_home@localhost:5433/whole_home
CONTEXT_CHAR_BUDGET=6000
DEFAULT_USER_ID=u1
DEFAULT_HOME_ID=h1
DEFAULT_TIMEZONE=Asia/Shanghai

# LLM 网关(strata,Anthropic 兼容接口)
LLM_BASE_URL=http://10.10.12.248:8081
LLM_MODEL=strata

# 设备适配器:mock | home_assistant
DEVICE_ADAPTER=mock
# DEVICE_ADAPTER=home_assistant 时必填(长期访问令牌)
HA_BASE_URL=
HA_TOKEN=

# 敏感配置(仅本地 .env,不提交)
LLM_AUTH_TOKEN=
HA_TOKEN=
